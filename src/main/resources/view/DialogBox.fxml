<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root type="HBox" xmlns="http://javafx.com/javafx/17.0.7"
         xmlns:fx="http://javafx.com/fxml/1" spacing="10">
    <children>
        <ImageView fx:id="avatar" styleClass="megatron-avatar" />
        <Label fx:id="messageLabel" styleClass="dialog-text" wrapText="true" maxWidth="450" />
    </children>
</fx:root>
